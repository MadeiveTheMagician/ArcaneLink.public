# Copy this file to .env and replace every `replace-with-...` value before deployment.
# Keep this value stable after first deployment: changing it selects a
# different set of Docker named volumes, including the PostgreSQL data volume.
COMPOSE_PROJECT_NAME=arcanelink

# Use non-overlapping container networks. Override these ranges when the host,
# LAN or VPN already routes one of them.
ARCANELINK_DEFAULT_SUBNET=172.28.248.0/24
ARCANELINK_EDGE_SUBNET=172.28.249.0/24
ARCANELINK_CORE_SUBNET=172.28.250.0/24

# PostgreSQL is exposed on loopback for local administration only.
POSTGRES_DB=arcanelink
POSTGRES_USER=arcanelink
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433

# The JWT secret must contain at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
ASPNETCORE_ENVIRONMENT=Production
ALLOWED_HOSTS=arcane-link.ru;www.arcane-link.ru
DATA_PROTECTION_KEYS_PATH=/app/data-protection-keys
FORWARDED_HEADERS_KNOWN_NETWORK=172.28.250.0/24

# Reverse proxy. For arcane-link.ru set TLS mode to `letsencrypt`, expose ports
# 80/443, and point TLS_CERTIFICATES_DIR at the host certificate directory.
ARCANELINK_SERVER_NAME=arcane-link.ru www.arcane-link.ru
ARCANELINK_TLS_MODE=letsencrypt
ARCANELINK_MAX_BODY_SIZE=12m
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
TLS_CERTIFICATES_DIR=/etc/letsencrypt
ARCANELINK_TLS_CERTIFICATE=/etc/letsencrypt/live/arcane-link.ru/fullchain.pem
ARCANELINK_TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/arcane-link.ru/privkey.pem

# URL checked by the deployment script after the containers become healthy.
PUBLIC_ORIGIN=https://arcane-link.ru
# Local SNI route used by the production readiness check. It avoids depending
# on router hairpin NAT while still validating the canonical HTTPS host.
SMOKE_RESOLVE=arcane-link.ru:443:127.0.0.1

# Voice is relay-only in production. The backend issues short-lived TURN
# credentials when docker-compose.turn.yml and .env.turn are enabled.

# Production requires a working SMTP relay for verification, password-reset
# and account-email-change messages. Keep credentials outside version control.
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=replace-with-smtp-host
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SSL_ON_CONNECT=false
EMAIL_SMTP_USERNAME=replace-with-smtp-username
EMAIL_SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM_ADDRESS=no-reply@arcane-link.ru
EMAIL_PUBLIC_ORIGIN=https://arcane-link.ru

# Deployment and retention policy.
RUN_QUALITY_GATES=1
RUN_BACKUP=1
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

ASSET_CLEANUP_ENABLED=true
ASSET_CLEANUP_DRY_RUN=true
ASSET_CLEANUP_RETENTION_DAYS=7
ASSET_CLEANUP_INTERVAL_MINUTES=60
ASSET_CLEANUP_BATCH_SIZE=100
