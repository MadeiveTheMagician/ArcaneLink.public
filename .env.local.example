# Local Docker environment template. Copy to .env and replace the two secret placeholders.
COMPOSE_PROJECT_NAME=arcanelink-local

# Use non-overlapping container networks. Override these ranges when the host,
# LAN or VPN already routes one of them.
ARCANELINK_DEFAULT_SUBNET=172.28.248.0/24
ARCANELINK_EDGE_SUBNET=172.28.249.0/24
ARCANELINK_CORE_SUBNET=172.28.250.0/24

POSTGRES_DB=arcanelink
POSTGRES_USER=arcanelink
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433

JWT_SECRET=replace-with-at-least-32-random-characters
ASPNETCORE_ENVIRONMENT=Docker
ALLOWED_HOSTS=localhost;127.0.0.1
DATA_PROTECTION_KEYS_PATH=/app/data-protection-keys
FORWARDED_HEADERS_KNOWN_NETWORK=172.28.250.0/24

ARCANELINK_SERVER_NAME=localhost
ARCANELINK_TLS_MODE=off
ARCANELINK_MAX_BODY_SIZE=12m
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
TLS_CERTIFICATES_DIR=./infrastructure/nginx/certs
ARCANELINK_TLS_CERTIFICATE=/etc/letsencrypt/live/arcane-link.ru/fullchain.pem
ARCANELINK_TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/arcane-link.ru/privkey.pem

PUBLIC_ORIGIN=http://127.0.0.1:8080
SMOKE_RESOLVE=

# Local startup works without an SMTP server. Messages remain in the outbox
# until delivery is enabled and valid relay settings are supplied.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SSL_ON_CONNECT=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_PUBLIC_ORIGIN=http://127.0.0.1:8080

RUN_QUALITY_GATES=1
RUN_BACKUP=1
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

ASSET_CLEANUP_ENABLED=true
ASSET_CLEANUP_DRY_RUN=true
ASSET_CLEANUP_RETENTION_DAYS=7
ASSET_CLEANUP_INTERVAL_MINUTES=60
ASSET_CLEANUP_BATCH_SIZE=100
