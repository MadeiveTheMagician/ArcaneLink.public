# Production TURN-only overlay. Copy to .env.turn and load it with docker-compose.turn.yml.
# It publishes control and relay ports; do not use it for an ordinary local run.
TURN_REALM=arcane-link.ru
TURN_PUBLIC_HOST=arcane-link.ru
TURN_EXTERNAL_IP=replace-with-public-ipv4
# Shared only by the backend and Coturn. Use at least 32 random bytes.
TURN_SHARED_SECRET=replace-with-at-least-32-random-bytes
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_CREDENTIAL_PERMIT_LIMIT=12
TURN_CREDENTIAL_WINDOW_SECONDS=60
# Coturn resource ceilings. Bandwidth values are bytes per second.
# Total quota must not exceed the number of ports in the relay range below.
TURN_USER_QUOTA=12
TURN_TOTAL_QUOTA=40
TURN_MAX_BPS=8000000
TURN_BPS_CAPACITY=125000000
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_BIND_ADDRESS=0.0.0.0
