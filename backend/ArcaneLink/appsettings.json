{
  "JwtSettings": {
    "Issuer": "ArcaneLink",
    "Audience": "ArcaneLinkClient",
    "SecretKey": "CHANGE_ME_SUPER_SECRET_KEY_MINIMUM_32_CHARS",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 180,
    "DeviceSessionIdleExpirationDays": 180,
    "DeviceSessionAbsoluteExpirationDays": 365
  },
  "Streaming": {
    "MaxBitrateByResolution": {
      "480p": 1200000,
      "720p": 2800000,
      "1080p": 5500000,
      "1440p": 10000000,
      "4k": 22000000,
      "source": 28000000
    }
  },
  "TurnCredentials": {
    "Enabled": false,
    "SharedSecret": "",
    "TtlSeconds": 600,
    "Urls": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Uploads": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Invites": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "DiscoverySearch": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "SignalRConnect": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "ModerationReports": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "TurnCredentials": {
      "PermitLimit": 12,
      "WindowSeconds": 60
    }
  },
  "RealtimePresence": {
    "DisconnectGraceSeconds": 20
  },
  "AuthorizationShadow": {
    "Enabled": false,
    "EnforcedPermissionCodes": []
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "ForwardLimit": 1,
    "RequireHeaderSymmetry": true,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "SecurityHeaders": {
    "ContentSecurityPolicyEnabled": true,
    "ContentSecurityPolicyReportOnly": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
