{
  "AssetUploads": {
    "DefaultAttachmentPlan": "free",
    "MaxImageUploadSizeBytes": 10485760,
    "AvatarSizePixels": 512,
    "AvatarWebpQuality": 82,
    "AvatarMaxDecodeSizePixels": 4096,
    "MaxAttachmentsPerMessage": 10,
    "MaxProfileBannerAssets": 10,
    "AttachmentSizeLimitsBytes": {
      "free": 10485760,
      "plus": 209715200,
      "prime": 1073741824
    },
    "AllowedImageMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "image/bmp"
    ],
    "DangerousAttachmentExtensions": [
      ".exe",
      ".com",
      ".scr",
      ".pif",
      ".bat",
      ".cmd",
      ".ps1",
      ".vbs",
      ".js",
      ".jse",
      ".wsf",
      ".wsh",
      ".msi",
      ".msp",
      ".appx",
      ".msix"
    ],
    "ArchiveAttachmentExtensions": [
      ".zip",
      ".rar",
      ".7z",
      ".tar",
      ".gz"
    ],
    "RegistryAttachmentExtensions": [
      ".reg"
    ]
  },
  "AssetCleanup": {
    "Enabled": false,
    "DryRun": true,
    "RetentionDays": 7,
    "IntervalMinutes": 60,
    "BatchSize": 100
  },
  "DataRetention": {
    "InvalidInviteRetentionDays": 60,
    "DeletedUserRetentionDays": 60,
    "DeletedServerRetentionDays": 60,
    "DeletedSpaceRetentionDays": 60,
    "DeletedMessageRetentionDays": 60
  }
}
