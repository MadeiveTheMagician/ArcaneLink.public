{
  "name": "@arcanelink/client-mobile",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "web:build": "npm --prefix ../client.web run build",
    "android:sync": "npm run web:build && cap sync android",
