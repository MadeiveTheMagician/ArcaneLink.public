    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@capacitor/core": "^8.4.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.0",
    "typescript": "~6.0.2"
  }
}
