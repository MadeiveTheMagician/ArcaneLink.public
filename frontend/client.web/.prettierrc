{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "singleQuote": true,
  "trailingComma": "none",
  "tabWidth": 2,
  "useTabs": false,
  "importOrder": [
    "^react",
    "<THIRD_PARTY_MODULES>",
    "^~/(.*)$",
    "^[./](?!.*\\.css$)",
    "\\.css$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderSideEffects": true
}
