{
  "name": "@arcanelink/client-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5174",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --config playwright.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@microsoft/signalr": "^10.0.0",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "overrides": {
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
